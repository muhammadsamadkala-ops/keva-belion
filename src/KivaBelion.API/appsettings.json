{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "IncludeScopes": true
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "KivaBelion.API",
    "Audience": "KivaBelion.Admin",
    "AccessTokenMinutes": 15
  },
  "RateLimiting": {
    "LoginPermitPerMinute": 5
  },
  "Features": {
    "TestMode": true,
    "OrdersEnabled": false,
    "OnlinePaymentsEnabled": false
  }
}
