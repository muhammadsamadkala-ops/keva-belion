# KIVA BELION API - names of settings the server needs. NO REAL VALUES IN THIS FILE.
#
# While developing on your PC you do NOT use a .env file: secrets live in "dotnet user-secrets"
# (scripts\set-dev-secrets.ps1 sets them). This file only lists the setting names so that,
# much later, you know what to type into a hosting provider's "Environment variables" page.
# .NET reads nested settings with a double underscore "__".
#
# Never put real values in this file and never commit a file with real values.

ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__Default=
Cors__AllowedOrigins__0=
Features__TestMode=true
Features__OrdersEnabled=false
Features__OnlinePaymentsEnabled=false
